# ============================================================
# 生产环境变量模板 - 复制为 .env.prod 后按需填写
#
# 为什么必须单独存在这个文件：
#   config.module.ts 按 NODE_ENV 加载 `.env.${NODE_ENV}`，
#   进程以 NODE_ENV=prod 启动时只认 `.env.prod`。
#   缺这个文件 → 全部走代码默认值 → 连不上库/存储 → 启动即失败。
#   deploy/template.sh 会先检查它，不存在直接报错退出。
#
# 注意：.env.prod 含真实密钥，**不要提交到 SVN**（.env.* 已在忽略规则里）。
# ============================================================

NODE_ENV=prod
PORT=3000
APP_NAME=template

# ---------------- 反向代理 ----------------
# Express trust proxy 跳数：1 = 信任一层前置代理（本机 Nginx）。
# 决定 req.ip 是否可信（限流键 / 审计与登录日志 IP）—— 不配则全校共用一个限流配额。
# 前面还有 CDN / 网关时按实际层数上调；Node 直连对外填 0。
TRUST_PROXY=1

# 接口前缀与版本：/api/v1
API_PREFIX=api
API_VERSION=1

LOG_LEVEL=info

# ---------------- JWT ----------------
# TODO(部署端) 必改：>=32 字节随机串，且**与 dev / test 不同**（openssl rand -base64 48）
# 漏改会使 NODE_ENV=prod 拒绝启动（env.validation.ts 会拦模板默认值与 <32 字符）
JWT_SECRET=change-me-to-random-32-bytes
JWT_EXPIRES_IN=2h
JWT_TOKEN_TTL=7200

# 与前端 VITE_CAPTCHA_ENABLED 必须一致，否则登录不了
CAPTCHA_ENABLED=false
FILTER_ENABLED=true
# 全局限流（默认 true）。生产保持开启；测试环境建议 false，否则高频登录会撞 429
THROTTLE_ENABLED=true
# 前端与后端同域（Nginx 反代），不需要 CORS；开启等于反射任意 Origin
CORS_ENABLED=false

# TODO(部署端)：等保 / 审计合规要求「操作返回时审计已落库」时改 sync。
# 注意 sync 也不会把审计并进业务事务（审计 append-only，业务事务此时已提交），
# 它只让写入延迟和失败在请求上可见。
AUDIT_MODE=async
# Outbox 终态事件保留天数（每小时回收；pending / processing 永不清理）
OUTBOX_SENT_RETENTION_DAYS=7
OUTBOX_FAILED_RETENTION_DAYS=30

# ---------------- 数据库 ----------------
# TODO(部署端) 确认主机；容器在本机则保持 127.0.0.1
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=template_prod
# TODO(部署端) 必改：与 `server/sql/databases.sql` 里给 template_prod 账号设的密码一致
# （账号隔离：这个账号只被授了 template_prod.*，读写不了 dev 库）
DB_PASSWORD=
# 生产库必须是 <项目>_prod；dev 库（<项目> 无后缀）对生产账号不可达
DB_DATABASE=template_prod
# 铁律：生产必须 false，表结构只能通过 migration 变更
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# ---------------- Redis ----------------
# TODO(部署端) 确认主机；与其它项目 / 环境共用实例时用 DB 索引隔离
CACHE_TYPE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# prod 建议用独立索引（如 4），避免与 dev(1) / test(2) 键冲突
REDIS_DB=4

# ---------------- 对象存储 ----------------
# 可拔插：s3 / local / memory。当前用独立 MinIO 容器（端口 9010）。
# TODO(部署端) 必改：MinIO 的访问密钥（容器 minio 的 MINIO_ROOT_USER/PASSWORD）
STORAGE_DRIVER=s3
STORAGE_DISK=default
STORAGE_S3_ENDPOINT=http://127.0.0.1:9010
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=template
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# MinIO 必须 true；AWS S3 / R2 用 false
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_SERVER_SIDE_ENCRYPTION=false
# 仅 STORAGE_DRIVER=local 时生效
STORAGE_LOCAL_ROOT=./data/uploads
