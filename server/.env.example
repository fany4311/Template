# 复制为 .env.dev / .env.test，按环境填值（不要提交真实密钥）
# 公共变量可放 .env.comm（先加载 .env.$NODE_ENV，再兜底 .env.comm）

NODE_ENV=dev
# 端口：**dev 用 3010，prod 用 3000**。
# 两套环境要能同时跑（dev 改代码、prod 对外服务互不影响），所以 dev 让开 3000。
# 见 deploy/ecosystem.dev.config.cjs 与 deploy/ecosystem.prod.config.cjs 顶部说明。
PORT=3010
APP_NAME=template

# 接口前缀与版本：/api/v1
API_PREFIX=api
API_VERSION=1

# 反向代理跳数（Express trust proxy）：1 = 信任一层前置代理（本机 Nginx）。
# 决定 req.ip 是否可信（限流键 / 审计与登录日志 IP）。
# 缺省即 1；Node 直连对外（不经代理）填 0，否则客户端可伪造 XFF。
TRUST_PROXY=1

# 日志
LOG_LEVEL=info

# JWT 认证（**生产必须改**：>=32 字节随机值，且与 dev / test 不同）
# 漏配/用模板值时，NODE_ENV=prod 会直接拒绝启动（见 src/core/config/env.validation.ts）
# 生成：openssl rand -base64 48
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=2h
JWT_TOKEN_TTL=7200

# 登录验证码开关（联调时可关；与前端 VITE_CAPTCHA_ENABLED 必须一致，否则登录不了）
# 生产建议开启：底座没有「按账号失败锁定」，关着时撞库只受 IP 限速约束。
CAPTCHA_ENABLED=false

# 统一异常过滤器 / CORS 开关
# 前后端同域（Nginx 反代）时 CORS 应为 false：开启等于反射任意 Origin
FILTER_ENABLED=true
# 全局限流开关（默认 true）：THROTTLE_ENABLED=false 时整体跳过限流。
# 只在测试里建议关闭 —— 同一 IP 高频登录会撞 429，测试结果时好时坏。
THROTTLE_ENABLED=true
CORS_ENABLED=false
# Swagger 文档：缺省时 dev/test 开、prod 关（显式 true 才开）
SWAGGER_ENABLED=false

# 审计写入模式：async（默认，进程内事件异步落库，业务不被审计拖慢）
#                    sync（请求内等落库再返回；等保/审计合规场景用，仍不回滚业务）
AUDIT_MODE=async

# Outbox 终态事件保留天数（每小时回收一次；pending / processing 永不清理）
OUTBOX_SENT_RETENTION_DAYS=7
OUTBOX_FAILED_RETENTION_DAYS=30
# 登录 / 审计日志留存天数（每小时回收；sys_config 里的同名配置优先）
LOGINLOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180

# 数据库（多驱动预留：mysql / mariadb / postgres / sqlite）
# 一库一账号：账号名 = 库名 + 角色（dev 无后缀 / _prod / _tmp），
# 且每个账号**只授自己的库**。定义在 server/sql/databases.sql，台账在 docs/库台账.md。
# 账号写成项目名（不带后缀）等于回到「一账号跨 dev+prod」的旧模型，别这么干。
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=template_dev
DB_PASSWORD=
DB_DATABASE=template
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# 缓存数据库（复用现有 Redis，用 DB 索引隔离：不同项目 / 环境各占一个）
CACHE_TYPE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# 对象存储（可拔插：s3 / local / memory）
# s3 兼容 MinIO / AWS S3 / Cloudflare R2 / B2；MinIO 必须 FORCE_PATH_STYLE=true
STORAGE_DRIVER=s3
STORAGE_DISK=default
STORAGE_S3_ENDPOINT=http://127.0.0.1:9010
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=template
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_SERVER_SIDE_ENCRYPTION=false
STORAGE_LOCAL_ROOT=./data/uploads
