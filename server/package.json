{
  "name": "template-server",
  "version": "0.0.1",
  "description": "Template 通用管理平台 - 后端服务（NestJS 12 + ESM）",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=dev nest start",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:debug": "cross-env NODE_ENV=dev nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:generate": "pnpm build && typeorm -d dist/core/database/data-source.js migration:generate",
    "migration:run": "pnpm build && typeorm -d dist/core/database/data-source.js migration:run",
    "migration:revert": "pnpm build && typeorm -d dist/core/database/data-source.js migration:revert",
    "migration:show": "pnpm build && typeorm -d dist/core/database/data-source.js migration:show",
    "openapi:dump": "pnpm build && cross-env NODE_ENV=dev node dist/scripts/dump-openapi.js",
    "authz:sync": "pnpm build && cross-env NODE_ENV=dev node dist/scripts/authz-sync.js",
    "gen:module": "pnpm build && node dist/scripts/gen-module.js"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@nestjs-cls/transactional": "^3.3.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^1.4.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/storage": "^0.0.4",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "nestjs-cls": "^6.3.1",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
